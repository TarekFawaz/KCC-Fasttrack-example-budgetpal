{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-statusline.sh\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-limit-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-hint.sh\" inject"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/check-impl-lock.sh\" --hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'echo \"[HOOK] Implementer starting. Branch: $(git branch --show-current). Uncommitted: $(git status --porcelain | wc -l) files\"'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-hint.sh\" inject"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if command -v powershell >/dev/null 2>&1; then powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.KCC/tools/record-token-actuals.ps1\" -FromHookStdin; else bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/record-token-actuals.sh\" --from-hook-stdin; fi'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-hint.sh\" inject"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-hint.sh\" inject"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-limit-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-dashboard-refresh.sh\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.KCC/tools/kcc-dashboard-refresh.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git status*)",
      "Read",
      "Glob",
      "Grep",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git tag*)",
      "Bash(git mv*)",
      "Bash(git merge*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(pnpm *)",
      "Bash(corepack *)",
      "Bash(docker compose*)",
      "Bash(docker build*)",
      "Bash(git rev-parse*)",
      "Bash(git config*)",
      "Bash(sh .KCC/tools/*)",
      "Bash(powershell *)",
      "Bash(pwsh *)",
      "Bash(bash *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pytest*)",
      "Bash(docker compose config*)",
      "Bash(bash .KCC/tools/*)",
      "Bash(bash ./.KCC/tools/*)",
      "Bash(powershell -ExecutionPolicy Bypass -File .KCC/*)",
      "Bash(powershell -ExecutionPolicy Bypass -File .KCC\\*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .KCC/*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .KCC\\*)",
      "Bash(mkdir*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(echo*)",
      "Bash(cd *)",
      "Bash(pwd*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(test *)",
      "Bash(touch*)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(sleep*)",
      "Bash(true*)"
    ]
  }
}
