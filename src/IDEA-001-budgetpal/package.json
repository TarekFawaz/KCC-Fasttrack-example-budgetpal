{
  "name": "budgetpal",
  "version": "0.1.0",
  "private": true,
  "description": "BudgetPal: self-hosted personal budgeting (pnpm workspace: api, web).",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "vitest run --config vitest.config.ts && pnpm -r --if-present test",
    "test:coverage": "vitest run --config vitest.config.ts --coverage && pnpm -r --if-present test:coverage",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
